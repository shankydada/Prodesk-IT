    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0",
    "multer": "^2.4.0"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0"
  }
