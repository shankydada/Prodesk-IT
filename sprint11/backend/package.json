{
  "name": "sprint11-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Sprint 11 Track B - Node/Express/MongoDB REST API with CORS, full CRUD and multipart asset uploads.",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
